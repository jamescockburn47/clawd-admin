[Unit]
Description=llama.cpp planner/classifier (Qwen3-4B-Instruct-2507 Q4_K_M, port 8085)
After=network.target

[Service]
Type=simple
User=james
LimitMEMLOCK=infinity
ExecStart=/home/james/llama.cpp/build/bin/llama-server \
  -m /home/james/models/Qwen_Qwen3-4B-Instruct-2507-Q4_K_M.gguf \
  --host 0.0.0.0 --port 8085 \
  -ngl 999 \
  -c 32768 \
  --parallel 1 \
  --reasoning off \
  --flash-attn on \
  --mlock \
  --no-mmap \
  --cont-batching \
  --cache-type-k q8_0 \
  --cache-type-v q8_0
Restart=on-failure
RestartSec=10
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
