[Unit]
Description=llama.cpp main server (Qwen3.6-27B Q8_0) — default chat model, language + coding, always-on
After=network.target

[Service]
Type=simple
User=james
LimitMEMLOCK=infinity
ExecStart=/home/james/llama.cpp/build/bin/llama-server \
  -m /mnt/storage/models/qwen36-27b/Qwen_Qwen3.6-27B-Q8_0.gguf \
  --host 0.0.0.0 --port 8080 \
  -ngl 999 \
  -c 32768 \
  --parallel 2 \
  --reasoning off \
  --flash-attn on \
  --mlock \
  --no-mmap \
  --cont-batching \
  --batch-size 1024 \
  --ubatch-size 512 \
  --cache-type-k q8_0 \
  --cache-type-v q8_0
Restart=on-failure
RestartSec=10
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
